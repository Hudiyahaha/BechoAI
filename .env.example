# Your Anthropic key (never commit the real .env file)
ANTHROPIC_API_KEY=
# Leave empty to use a local SQLite file (bechoai.db). Set a Postgres URL when deploying.
DATABASE_URL=
# Where chats and customer memories are saved. Leave empty for bechoai_memory.db.
MEMORY_DB_PATH=
# Secret for signing login tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: dashboard login for the demo store, created by python -m app.seed
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=
